&RUN_PARAMS
hydro=.true.
static=.true.
nrestart=0
rt=.true.
nstepmax=1
verbose=.false.
/

&INIT_PARAMS
nregion=1
region_type(1)='square'
x_center=0.5
y_center=0.5
z_center=0.5
length_x=100.0
length_y=100.0
exp_region=10.0
d_region=1.d-3	  		! cm-3
p_region= 8.69869d-8		        ! =10^4 K
/

&AMR_PARAMS
levelmin=6
levelmax=6 ! Currently it is impossible to refine with static=.true.
ngridmax=50000
boxlen=6.6			!  6.6 kpc
/

&OUTPUT_PARAMS
noutput=5
tout=10,30,100,200,500
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
scheme='muscl'
slope_type=1
data_dir='../../rtzdata_for_public_ramses/'
/

&COOLING_PARAMS
cooling=.false.
metal=.true.
z_ave=1d0
/

&UNITS_PARAMS
units_density=1.66d-24		! gram per proton
units_time=3.1557d13		! 1 Myr in seconds
units_length=3.0857d21 		! 1 kpc in cm
/

&REFINE_PARAMS
err_grad_d=0.1
/

&RT_PARAMS
rt_flux_scheme='glf'
rt_c_fraction=0.01
rt_otsa=.true.			! no OTSA
rt_is_init_xion=.false.
!----------- RTZ params -----------!
rtz_cooling=.true.
rtz_equilibrium_test=1
rtz_include_collisional_ionization=.true.
rtz_include_photoionization=.true.
rtz_include_cosmic_ray_ionization=.true.
rtz_include_charge_exchange=.true.
rtz_include_dust_recombination=.true.
rtz_include_HM12_UVB=.false.
!rtz_include_auger_ionization=.false.
!rtz_include_secondary_ionizations=.false.
isH2_rtz=.true.
isCO_rtz=.true.
rtz_UV_background_G0=1.d0
rtz_primary_cosmic_ray_ionization_rate=1.d-16
rtz_eqm_min_its=10000
rtz_max_cool_timestep=1.d20
/

&RT_GROUPS
groupL0 = 13.6d0
groupL1 = 500.d0
/

&BOUNDARY_PARAMS
nboundary=6
ibound_min=-1,+1,-1,-1,-1,-1
ibound_max=-1,+1,+1,+1,+1,+1
jbound_min= 0, 0,-1,+1,-1,-1
jbound_max= 0, 0,-1,+1,+1,+1
kbound_min= 0, 0, 0, 0,-1,+1
kbound_max= 0, 0, 0, 0,-1,+1
bound_type= 1, 2, 1, 2, 1, 2	! Reflective+outflow boundaries
/

&CALIMA_PARAMS
!----------- Global CALIMA parameters -----------!
dust_test=.true.
test_nH=1.0d0
test_Tk=2.0d6               ! High temperature required for thermal sputtering
test_ne=1.2d0               ! Fully ionized gas
test_mu=0.586d0
test_nsteps=400
test_dt=5.0d4               ! Total 20 Myr evolution
dust_solver_type=3          ! RK54 solver

dust_sputtering=.true.      ! Enable thermal sputtering
sputtering_model='RM2026'
dust_sputtering_charge=.true.
charging_model='RM2026'
nZmix=3

!----------- Efficiency parameters -----------!
Sconstant=0.333333333d0
nhmax_acc=1d12,1d12
Coulomb_enhance=1d0,1d0

!----------- Grain material parameters -----------!
tensile_strength=2d8,1.5d9
Youngs_modulus=1.0d11,5.4d11
Poisson_ratio=0.32,0.17
surf_energy=75d0,25d0 
work_function=4.4d0,8.0d0
band_gap=0.0d0,5.0d0
e_escape_length=1d-7,1d-7
separate_refractive_index=.true.,.false.
slope_frag_func=0.4333d0

!----------- Initialisation parameters -----------!
DTMinit=0.4d0
fpah_ini=0.1d0

!----------- DustBin properties -----------!
dust_composition(1,6) = 1d0
dust_composition(2,8)  = 4d0
dust_composition(2,12) = 1d0
dust_composition(2,14) = 1d0
dust_composition(2,26) = 1d0
dustbins_per_chemtype=2,2
asize=0.01d0,0.1d0,0.005d0,0.1d0
sgrain=2.2d0,2.2d0,3.3d0,3.3d0
amin = 4d-3,3d-2,1d-3,2d-2
amax = 3d-2,1d0,2d-2,1d0

!----------- PAHBin properties -----------!
pah_nc = 54,418
pah_nc_min = 12,101
pah_nc_max = 101,29952
spah = 2d0,2d0
pah_ncharge_states = 4, 4
pah_is_cluster = .false.,.true.

!----------- Data files -----------!
dust_tables_dir='/Users/currodri/Documents/RAMSES_dev/rtzdata_for_public_ramses/calima_data/'
/
