! tests/passive_scalars/advect: a composition profile (ic_table.dat, patch/condinit.f90)
! advected through a periodic box at u=1, p=1, for {crossings} crossing(s).
! Pure transport: cooling and the RTZ chemistry are off, cooling_fine still runs
! (neq_chem) so that its reads/writes and clamps are exercised.
&RUN_PARAMS
hydro=.true.
rt=.false.
poisson=.false.
nrestart=0
ncontrol=1000
nstepmax=1000000
verbose=.false.
/
&AMR_PARAMS
levelmin={levelmin}
levelmax={levelmax}
ngridmax=20000
nexpand=1
boxlen=1.0
/
&INIT_PARAMS
condinit_kind='table'
/
&OUTPUT_PARAMS
foutput=100000000
tend={tend}
delta_tout={delta_tout}
/
&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
scheme='muscl'
slope_type={slope}
riemann='{riemann}'
pressure_fix=.false.
data_dir='{data_dir}'
{hydro_extra}
/
&REFINE_PARAMS
{refine}
/
&COOLING_PARAMS
cooling=.false.
metal=.true.
neq_chem=.true.
z_ave=1
/
&UNITS_PARAMS
units_density=1.66e-24
units_time=3.0857e12
units_length=3.0857e18
/
&BOUNDARY_PARAMS
{boundary}
/
&RT_PARAMS
X=0.74
Y=0.25
rt_is_init_xion=.false.
rtz_cooling={rtz_cooling}
isHe={isHe}
isH2_rtz={isH2}
isCO_rtz={isCO}
{rt_extra}
/
&RT_GROUPS
groupL0 = 13.6
groupL1 = 500
/
