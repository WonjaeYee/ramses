This is the RAMSES parameter file for the DustySpress test.

&RUN_PARAMS
hydro=.true.
rt=.true.
static=.true.
/

&AMR_PARAMS
levelmin=7
levelmax=8
ngridmax=2000
nparttot=1 
nexpand=1
boxlen=10.0
/

&BOUNDARY_PARAMS
nboundary=2
ibound_min=-1,+1
ibound_max=-1,+1
bound_type= 2, 2
/

&INIT_PARAMS
condinit_kind='dustyspress'
nregion=1
region_type(1)='square'
x_center=5.0
length_x=10.0
d_region=0.204537956
u_region=0.0
p_region=0.14609854
var_region(1,:)=0.0
/

&OUTPUT_PARAMS
noutput=5
tout = 1.0,2.0,4.0,6.0             ! 4 outputs spaced by exactly 0.74 Myr
tend = 6.0!2.96                               ! Hard stop before hitting the right boundary
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
slope_type=2
riemann='hllc'
data_dir = '/Users/currodri/Documents/RAMSES_dev/rtzdata_for_public_ramses/'
/
&COOLING_PARAMS
    metal = .true.
    cooling = .false.
/

&REFINE_PARAMS
err_grad_d=0.05
err_grad_u=0.05
err_grad_p=0.05
interpol_var=0
interpol_type=2
err_grad_var(12)=0.05
/

&UNITS_PARAMS
units_length = 3.08567758149137d18 ! 1 pc in cm
units_density = 1e-24 ! 1e-24 g/cm3
units_time = 3.1556926d13 ! 1 Myr in s
/

&RT_PARAMS
rt_flux_scheme='glf'
rt_c_fraction=0.001
rt_otsa=.true.			! no OTSA
rt_is_init_xion=.false.
rt_Tconst=82.831325d0
rt_nsubcycle=518
!----------- RTZ params -----------!
rtz_cooling=.true.
rtz_include_collisional_ionization=.true.
rtz_include_photoionization=.true.
rtz_include_cosmic_ray_ionization=.true.
rtz_include_charge_exchange=.true.
rtz_include_dust_recombination=.true.
rtz_include_HM12_UVB=.false.
isH2_rtz=.true.
isCO_rtz=.true.
rtz_UV_background_G0=1.d0
rtz_primary_cosmic_ray_ionization_rate=1.d-16
rtz_max_cool_timestep=1.d20
!----------- RT Sources -----------!
rt_nsource = 1
rt_source_type(1) = 'square'
rt_exp_source(1) = 10.0
rt_src_x_center(1) = 0.0
rt_src_length_x(1) = 0.625
rt_u_source(1) = 1.0
rt_n_source(1) = 1.0d6
rt_src_group(1) = 1
/

&RT_GROUPS
group_egy     = 8.0
groupL0       = 5.0
groupL1       = 10.0
/

&CALIMA_PARAMS
dust_tva=.true.
dust_radpressure=.true.
use_w_drift_test=.false.
!w_drift_test=0.77692,0.0,0.0
dust_composition(1,6) = 1d0
dustbins_per_chemtype=1
asize=0.1d0
sgrain=2.2d0
amin = 3d-2
amax = 1.0d0
charging_model='RM2026'
dust_tables_dir='/Users/currodri/Documents/RAMSES_dev/rtzdata_for_public_ramses/calima_data/'
/