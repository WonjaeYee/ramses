RAMSES parameter file for the DustyIRtrap test.

Uniform static gas with a uniform dust-to-gas ratio plus a small Gaussian
tracer, and a LINEAR trapped-IR radiation pressure ramp imposed in condinit
and held fixed (condinit_kind='dustyirtrap' => TVA_TEST_IRTRAP, which skips
the trapped/streaming re-partition in cooling_fine).

With NDUST=1 and NPAH=0 the Rosseland opacity share is s_1 = 1 identically,
so the predicted terminal drift is independent of the dust optical tables:

  grad(P_trap) = -Ptrap_0*Ptrap_dl/boxlen           (constant, negative)
  D_1          = -grad(P_trap) * (1/rho_d - 1/rho_mix)
  w_d          = (1 - eps)*t_s*D_1 ,  w_g = -eps*t_s*D_1
  t_s          = sqrt(pi*gamma/8) * s_grain*a_grain / (rho_gas*c_s)

&RUN_PARAMS
hydro=.true.
rt=.true.
static=.true.
/

&AMR_PARAMS
levelmin=7
levelmax=7
ngridmax=2000
nparttot=1
nexpand=1
boxlen=10.0
/

&BOUNDARY_PARAMS
nboundary=2
ibound_min=-1,+1
ibound_max=-1,+1
bound_type= 2, 2
/

&INIT_PARAMS
condinit_kind='dustyirtrap'
nregion=1
region_type(1)='square'
x_center=5.0
length_x=10.0
d_region=0.204537956
u_region=0.0
p_region=0.14609854
var_region(1,:)=0.0
/

&OUTPUT_PARAMS
noutput=2
tout = 0.125,0.25
tend = 0.25
/

&HYDRO_PARAMS
gamma=1.4
courant_factor=0.8
slope_type=2
riemann='hllc'
data_dir = '/Users/currodri/Documents/RAMSES_dev/rtzdata_for_public_ramses/'
/

&COOLING_PARAMS
metal = .true.
cooling = .false.
/

&REFINE_PARAMS
interpol_var=0
interpol_type=2
/

&UNITS_PARAMS
units_length = 3.08567758149137d18 ! 1 pc in cm
units_density = 1e-24 ! 1e-24 g/cm3
units_time = 3.1556926d13 ! 1 Myr in s
/

&RT_PARAMS
rt_flux_scheme='glf'          ! mandatory for IR trapping (RT15 footnote 3)
rt_c_fraction=0.001
rt_otsa=.true.
rt_is_init_xion=.false.
rt_Tconst=82.831325d0
rt_nsubcycle=518
rt_isIR=.true.                ! group 1 is the IR band
rt_isIRtrap=.true.            ! trapped IR in the NENER slot
!----------- RTZ params -----------!
rtz_cooling=.true.
rtz_include_collisional_ionization=.true.
rtz_include_photoionization=.true.
rtz_include_cosmic_ray_ionization=.true.
rtz_include_charge_exchange=.true.
rtz_include_dust_recombination=.true.
rtz_include_HM12_UVB=.false.
isH2_rtz=.true.
isCO_rtz=.true.
rtz_UV_background_G0=1.d0
rtz_primary_cosmic_ray_ionization_rate=1.d-16
rtz_max_cool_timestep=1.d20
!----------- RT source -----------!
! A weak source keeps the RTZ network out of the fully dark, cold molecular
! corner where rtz_solve_cooling fails to converge. It is not needed by the
! trapped-IR physics under test: TVA_TEST_IRTRAP holds E_trap at the analytic
! profile from condinit regardless of the radiation field.
rt_nsource = 0
rt_source_type(1) = 'square'
rt_exp_source(1) = 10.0
rt_src_x_center(1) = 0.0
rt_src_length_x(1) = 0.625
rt_u_source(1) = 1.0
rt_n_source(1) = 1.0d6
rt_src_group(1) = 1
/

&RT_GROUPS
group_egy     = 0.4           ! IR band, ~1-6 micron
groupL0       = 0.1
groupL1       = 1.0
/

&CALIMA_PARAMS
dust_tva=.true.
dust_radpressure=.true.
use_w_drift_test=.false.
dust_composition(1,6) = 1d0
dustbins_per_chemtype=1
asize=0.01d0                  ! must match averaged_cross_section_DustBin_01.txt (0.01 um)
sgrain=2.2d0
amin = 3d-2
amax = 1.0d0
charging_model='RM2026'
dust_tables_dir='/Users/currodri/Documents/RAMSES_dev/rtzdata_for_public_ramses/calima_data/'
/
